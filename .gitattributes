# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Binary assets
*.png binary
*.webp binary
*.woff2 binary
*.mo binary

# Development files left out of the theme zip (git archive)
.gitattributes export-ignore
.gitignore export-ignore
.github export-ignore
bin export-ignore
tests export-ignore
/.claude export-ignore
